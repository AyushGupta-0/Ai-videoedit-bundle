{
  "duration": 74.73,
  "lines": [
    {
      "id": "l01",
      "who": "N",
      "shot": "jam",
      "text": "Day one. Four lanes of traffic that haven't moved in forty minutes.",
      "start": 0.25,
      "end": 5.55
    },
    {
      "id": "l02",
      "who": "N",
      "shot": "jam",
      "text": "And nobody is honking.",
      "start": 5.61,
      "end": 7.985
    },
    {
      "id": "l03",
      "who": "N",
      "shot": "radio",
      "text": "Then the radio cuts out mid sentence.",
      "start": 8.585,
      "end": 11.66
    },
    {
      "id": "l04",
      "who": "N",
      "shot": "radio",
      "text": "Emergency broadcast, one loop. Stay in your vehicle. Recovery in ten days.",
      "start": 11.72,
      "end": 17.795
    },
    {
      "id": "l05",
      "who": "N",
      "shot": "rule1",
      "text": "Rule one. Engine off. An idling car is audible at two hundred metres.",
      "start": 18.245,
      "end": 24.245
    },
    {
      "id": "l06",
      "who": "N",
      "shot": "rule2",
      "text": "Rule two. Hazards off. Light is an address.",
      "start": 24.305,
      "end": 28.205
    },
    {
      "id": "l07",
      "who": "N",
      "shot": "rule3",
      "text": "Rule three. If someone outside uses your name, do not answer.",
      "start": 28.265,
      "end": 33.215
    },
    {
      "id": "l08",
      "who": "N",
      "shot": "good",
      "text": "Good news. Half a tank, a bottle of water, and a hand crank radio.",
      "start": 33.915,
      "end": 39.24
    },
    {
      "id": "l09",
      "who": "N",
      "shot": "bad",
      "text": "Bad news. Your window has been stuck two inches open since August.",
      "start": 39.3,
      "end": 44.525
    },
    {
      "id": "l10",
      "who": "N",
      "shot": "torch",
      "text": "Eleven fifty two. A torch starts moving down the line of cars.",
      "start": 45.075,
      "end": 50.125
    },
    {
      "id": "l11",
      "who": "N",
      "shot": "torch",
      "text": "It stops at yours.",
      "start": 50.185,
      "end": 52.385
    },
    {
      "id": "l12",
      "who": "N",
      "shot": "tap",
      "text": "Someone taps the glass. Twice.",
      "start": 53.235,
      "end": 56.11
    },
    {
      "id": "l13",
      "who": "N",
      "shot": "voice",
      "text": "It's Marcus. Paramedic. You're bleeding, let me in.",
      "start": 56.66,
      "end": 60.585
    },
    {
      "id": "l14",
      "who": "N",
      "shot": "radio2",
      "text": "All response units withdrew six hours ago.",
      "start": 61.185,
      "end": 64.835
    },
    {
      "id": "l15",
      "who": "N",
      "shot": "radio2",
      "text": "And you're not bleeding.",
      "start": 64.895,
      "end": 66.97
    },
    {
      "id": "l16",
      "who": "N",
      "shot": "name",
      "text": "Then it says your name.",
      "start": 68.02,
      "end": 70.195
    },
    {
      "id": "l17",
      "who": "N",
      "shot": "end",
      "text": "Do you open the door?",
      "start": 71.295,
      "end": 73.47
    }
  ]
}