{
  "duration": 58.035,
  "lines": [
    {
      "id": "l01",
      "who": "N",
      "shot": "f01",
      "text": "Eight days. Anaya went to the shop at the end of the lane.",
      "start": 0.3,
      "end": 4.575
    },
    {
      "id": "l02",
      "who": "N",
      "shot": "f02",
      "text": "She had walked past it a hundred times without going in.",
      "start": 5.4,
      "end": 9.5
    },
    {
      "id": "l03",
      "who": "N",
      "shot": "f03",
      "text": "There it was. The big box. The one that goes up like a tree.",
      "start": 10.2,
      "end": 14.825
    },
    {
      "id": "l04",
      "who": "N",
      "shot": "f04",
      "text": "Forty rupees, she said. I have forty-two.",
      "start": 16.0,
      "end": 19.6
    },
    {
      "id": "l05",
      "who": "N",
      "shot": "f05",
      "text": "She put every coin on the counter.",
      "start": 21.0,
      "end": 23.85
    },
    {
      "id": "l06",
      "who": "N",
      "shot": "f06",
      "text": "It's the festival, the shopkeeper said. The price went up.",
      "start": 24.6,
      "end": 28.925
    },
    {
      "id": "l07",
      "who": "N",
      "shot": "f06",
      "text": "Sixty.",
      "start": 30.0,
      "end": 31.825
    },
    {
      "id": "l08",
      "who": "N",
      "shot": "f07",
      "text": "She counted her coins one more time, as if they might have grown.",
      "start": 32.0,
      "end": 36.775
    },
    {
      "id": "l09",
      "who": "N",
      "shot": "f08",
      "text": "They had not.",
      "start": 38.0,
      "end": 40.025
    },
    {
      "id": "l10",
      "who": "N",
      "shot": "f08",
      "text": "She picked them up, and she walked home.",
      "start": 40.2,
      "end": 43.3
    },
    {
      "id": "l11",
      "who": "N",
      "shot": "f09",
      "text": "Then he called after her.",
      "start": 44.4,
      "end": 46.9
    },
    {
      "id": "l12",
      "who": "N",
      "shot": "f09",
      "text": "There's one box left at the old price.",
      "start": 47.0,
      "end": 50.25
    },
    {
      "id": "l13",
      "who": "N",
      "shot": "f10",
      "text": "But it's promised to somebody else.",
      "start": 50.6,
      "end": 53.45
    },
    {
      "id": "l14",
      "who": "N",
      "shot": "f10",
      "text": "He's coming at six o'clock.",
      "start": 54.0,
      "end": 56.775
    }
  ]
}