  "lines": [
    {
      "id": "l01",
      "at": 0.3,
      "who": "N",
      "shot": "h01",
      "text": "Six days. The market opens before the sun does."
    },
    {
      "id": "l02",
      "at": 4.6,
      "who": "N",
      "shot": "h02",
      "text": "Anaya had a list. Papa's favourite lunch needs seven things."
    },
    {
      "id": "l03",
      "at": 10.0,
      "who": "N",
      "shot": "h03",
      "text": "Tomatoes. She picked the reddest ones."
    },
    {
      "id": "l04",
      "at": 13.6,
      "who": "N",
      "shot": "h04",
      "text": "She had never bargained before. She did it badly, and she did it anyway."
    },
    {
      "id": "l05",
      "at": 20.0,
      "who": "N",
      "shot": "h05",
      "text": "Onions. Chillies. Coriander. Rice."
    },
    {
      "id": "l06",
      "at": 24.4,
      "who": "N",
      "shot": "h06",
      "text": "She counted her coins out slowly, so she would not make a mistake."
    },
    {
      "id": "l07",
      "at": 30.0,
      "who": "N",
      "shot": "h07",
      "text": "And then there were none left."
    },
    {
      "id": "l08",
      "at": 33.0,
      "who": "N",
      "shot": "h08",
      "text": "Six things in the bag. One thing missing."
    },
    {
      "id": "l09",
      "at": 37.0,
      "who": "N",
      "shot": "h09",
      "text": "The one thing the dish cannot be made without."
    },
    {
      "id": "l10",
      "at": 41.0,
      "who": "N",
      "shot": "h10",
      "text": "She looked past the stalls, out to where the fields begin."
    },
    {
      "id": "l11",
      "at": 46.4,
      "who": "N",
      "shot": "h10",
      "text": "Somebody out there grows them."
    }
  ]
}
