{
  "duration": 75.88,
  "lines": [
    {
      "id": "l01",
      "who": "N",
      "shot": "recap",
      "text": "You didn't open the door. You drove.",
      "start": 0.25,
      "end": 3.3
    },
    {
      "id": "l02",
      "who": "N",
      "shot": "park",
      "text": "A car park is the safest place to sleep in an outbreak.",
      "start": 4.0,
      "end": 8.25
    },
    {
      "id": "l03",
      "who": "N",
      "shot": "park",
      "text": "Until you count the cars twice.",
      "start": 8.46,
      "end": 11.085
    },
    {
      "id": "l04",
      "who": "N",
      "shot": "ramp",
      "text": "Day two. Level four. Concrete has no windows.",
      "start": 11.735,
      "end": 15.91
    },
    {
      "id": "l05",
      "who": "N",
      "shot": "ramp",
      "text": "High enough off the street. Low enough to drive down fast.",
      "start": 15.97,
      "end": 20.445
    },
    {
      "id": "l06",
      "who": "N",
      "shot": "radio",
      "text": "Radio, same loop. Recovery in nine days.",
      "start": 20.505,
      "end": 24.505
    },
    {
      "id": "l07",
      "who": "N",
      "shot": "rule1",
      "text": "Rule one. Park facing the exit.",
      "start": 24.905,
      "end": 28.08
    },
    {
      "id": "l08",
      "who": "N",
      "shot": "rule2",
      "text": "Rule two. Never sleep in the driver's seat.",
      "start": 28.14,
      "end": 31.715
    },
    {
      "id": "l09",
      "who": "N",
      "shot": "rule3",
      "text": "Rule three. Count the cars before dark.",
      "start": 31.775,
      "end": 35.225
    },
    {
      "id": "l10",
      "who": "N",
      "shot": "good",
      "text": "Good news. Eleven cars. Yours is the twelfth.",
      "start": 35.925,
      "end": 40.15
    },
    {
      "id": "l11",
      "who": "N",
      "shot": "bad",
      "text": "Bad news. The stairwell door doesn't lock. It only closes.",
      "start": 40.21,
      "end": 45.11
    },
    {
      "id": "l12",
      "who": "N",
      "shot": "door",
      "text": "Three forty A M. The door opens, and someone lets it close softly.",
      "start": 45.71,
      "end": 51.06
    },
    {
      "id": "l13",
      "who": "N",
      "shot": "door",
      "text": "Someone who didn't want it to bang.",
      "start": 51.12,
      "end": 53.87
    },
    {
      "id": "l14",
      "who": "N",
      "shot": "steps",
      "text": "Then footsteps. Not shuffling. Walking.",
      "start": 54.62,
      "end": 57.895
    },
    {
      "id": "l15",
      "who": "N",
      "shot": "voice",
      "text": "I saw your brake lights. Which car are you in?",
      "start": 58.445,
      "end": 61.97
    },
    {
      "id": "l16",
      "who": "N",
      "shot": "dash",
      "text": "You haven't touched the brakes since yesterday.",
      "start": 62.67,
      "end": 65.845
    },
    {
      "id": "l17",
      "who": "N",
      "shot": "count",
      "text": "So you count again.",
      "start": 66.745,
      "end": 68.77
    },
    {
      "id": "l18",
      "who": "N",
      "shot": "count",
      "text": "Thirteen.",
      "start": 69.62,
      "end": 71.295
    },
    {
      "id": "l19",
      "who": "N",
      "shot": "end",
      "text": "Do you start the engine?",
      "start": 72.395,
      "end": 74.62
    }
  ]
}